# --- חובה ---
# חיבור ל-Postgres (Neon / Supabase / Vercel Postgres). בלי זה האפליקציה לא תעלה בפרודקשן.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# סיסמת מנהל לפאנל /admin
ADMIN_PASSWORD=change-me
# מחרוזת אקראית ארוכה לחתימת עוגיית המנהל (openssl rand -hex 32)
SESSION_SECRET=change-me-too
# סוד ל-Vercel Cron (Vercel שולח אותו אוטומטית בכותרת Authorization)
CRON_SECRET=change-me-three

# --- שליחת האקסל במייל (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Timesheet <reports@your-domain.com>
# כתובות שיקבלו את האקסל ב-19 לחודש, מופרדות בפסיק
ADMIN_EMAIL=you@example.com

# --- אופציונלי ---
# היום בחודש שבו תקופת הדיווח מתחילה. 20 (ברירת מחדל) = מ-20 עד 19 בחודש הבא. 1 = חודש קלנדרי.
PERIOD_START_DAY=20
